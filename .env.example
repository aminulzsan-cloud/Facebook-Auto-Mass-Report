# Server
PORT=3000
MONGODB_URI=mongodb://localhost:27017/fb-report-store
JWT_SECRET=change-this-to-a-strong-random-secret
BASE_URL=http://localhost:3000

# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=change-this-password

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Crypto wallet addresses
WALLET_BTC=bc1q_your_btc_address_here
WALLET_ETH=0x_your_eth_address_here
WALLET_USDT=T_your_trc20_usdt_address_here
WALLET_LTC=ltc1q_your_ltc_address_here

# Blockcypher API token (free at blockcypher.com)
BLOCKCYPHER_TOKEN=your-blockcypher-api-token

# Download token signing secret
DOWNLOAD_SECRET=change-this-to-another-strong-secret

# Product config
PRODUCT_PRICE=49
PRODUCT_NAME=Facebook Mass Report Tool
